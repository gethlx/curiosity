          "text": "边界在哪里？"
        }
      ],
      "items": [
        {
          "type": "userMessage",
          "id": "01a16aa6-ff7a-7c60-8322-82e35239089f",
          "clientId": null,
          "content": [
            {
              "type": "text",
              "text": "边界在哪里？",
              "text_elements": []
