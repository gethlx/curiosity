              "diff": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <title>影子有多长？｜光线角度交互图解</title>\n  <style>\n    :root{--ink:#182a32;--muted:#587078;--paper:#f7f6f0;--card:#fffefa;--line:#d9e2dc;--sun:#e5a934;--ray:#d77948;--shadow:#416b81;--accent:#146b64;--soft:#e8f2ed}\n    *{box-sizing:border-box}\n    body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 system-ui,-apple-system,\"PingFang SC\",\"Noto Sans CJK SC\",sans-serif}\n    main{width:min(1040px,100%);margin:auto;padding:34px 24px 48px}\n    header{max-width:760px;margin-bottom:24px}\n    .eyebrow{margin:0 0 8px;color:var(--accent);font-size:.82rem;font-weight:750;letter-spacing:.08em}\n    h1{font-size:clamp(2rem,5vw,3.4rem);line-height:1.13;letter-spacing:-.04em;margin:0 0 14px}\n    .intro{font-size:1.08rem;color:#3d565d;max-width:690px;margin:0}\n    .layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.8fr);gap:18px;align-items:stretch}\n    .card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 8px 28px #29473c0b}\n    h2{font-size:1.12rem;margin:0 0 12px;letter-spacing:-.015em}\n    .diagram-card{display:flex;flex-direction:column;min-width:0}\n    .diagram-wrap{border-radius:14px;background:#f1f5f0;overflow:hidden;min-height:235px;display:grid;place-items:center}\n    svg{display:block;width:100%;height:260px}\n    .key{display:flex;flex-wrap:wrap;gap:8px 18px;margin:14px 0 0;color:var(--muted);font-size:.9rem}\n    .key span{display:flex;align-items:center;gap:7px}\n    .swatch{width:17px;height:4px;border-radius:4px;background:var(--ray)}.swatch.shadow{background:var(--shadow)}.swatch.pole{width:4px;height:17px;background:var(--accent)}\n    .diagram-note{font-size:.84rem;color:var(--muted);margin:9px 0 0}\n    .controls{display:flex;flex-direction:column;gap:20px}\n    .angle-readout{display:flex;align-items:baseline;gap:8px;margin:2px 0 7px}\n    output{font-size:2.4rem;line-height:1;font-weight:760;letter-spacing:-.05em;font-variant-numeric:tabular-nums;color:var(--accent)}\n    label{font-weight:680}\n    input[type=range]{display:block;width:100%;margin:17px 0 4px;accent-color:var(--accent);cursor:pointer;min-height:28px}\n    input[type=range]:focus-visible{outline:3px solid #87bcb5;outline-offset:5px;border-radius:8px}\n    .range-labels{display:flex;justify-content:space-between;color:var(--muted);font-size:.84rem}\n    .result{background:var(--soft);border-radius:14px;padding:16px}\n    .result-label{font-size:.88rem;color:#4d6668;margin:0 0 2px}\n    .result-value{font-size:2rem;line-height:1.2;font-weight:760;font-variant-numeric:tabular-nums;letter-spacing:-.04em;margin:0;color:var(--ink)}\n    .result-value small{font-size:1rem;font-weight:600;letter-spacing:0;color:#4d6668}\n    .explain{margin:10px 0 0;color:#345059;font-size:.94rem}\n    .math{margin-top:18px}\n    .equation{border-left:3px solid var(--sun);padding:2px 0 2px 14px;font-size:1.1rem;font-weight:680;line-height:1.5}\n    .equation small{display:block;font-size:.92rem;font-weight:450;color:var(--muted)}\n    .bottom{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}\n    .bottom p{margin:0;color:#3d565d}\n    .limits{border-top:1px solid var(--line);margin-top:14px;padding-top:13px;font-size:.9rem;color:var(--muted)}\n    .sources{margin-top:18px;color:var(--muted);font-size:.84rem}\n    .sources p{margin:4px 0}\n    @media(max-width:760px){main{padding:26px 16px 34px}.layout{grid-template-columns:1fr}.diagram-wrap{min-height:205px}svg{height:230px}.controls{gap:15px}.bottom{grid-template-columns:1fr}.card{padding:19px}}\n    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}\n  </style>\n</head>\n<body>\n<main>\n  <header>\n    <p class=\"eyebrow\">从一根竖直的小杆开始</p>\n    <h1>光线角度一变，影子会怎样？</h1>\n    <p class=\"intro\">看地上的影子，可以把光线、杆和地面拼成一个直角三角形。拖动角度，观察同一根杆的影长如何变化。</p>\n  </header>\n\n  <section class=\"layout\" aria-label=\"影长互动图解\">\n    <article class=\"card diagram-card\">\n      <h2>把光线和影子画出来</h2>\n      <div class=\"diagram-wrap\">\n        <svg id=\"diagram\" viewBox=\"0 0 500 260\" role=\"img\" aria-labelledby=\"svgTitle svgDesc\">\n          <title id=\"svgTitle\">竖直杆、平行光线与地面影子的直角三角形</title>\n          <desc id=\"svgDesc\">杆高一米，光线与水平地面的夹角会随滑块改变，影长按同一比例绘制。</desc>\n          <defs><marker id=\"arrow\" markerWidth=\"7\" markerHeight=\"7\" refX=\"3.5\" refY=\"3.5\" orient=\"auto-start-reverse\"><path d=\"M0,0 L7,3.5 L0,7\" fill=\"none\" stroke=\"#416b81\" stroke-width=\"1.4\"/></marker></defs>\n          <circle cx=\"90\" cy=\"44\" r=\"17\" fill=\"#f5d989\"/>\n          <path id=\"lightRay\" d=\"\" fill=\"none\" stroke=\"#d77948\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n          <path id=\"triangle\" d=\"\" fill=\"#416b81\" opacity=\".12\"/>\n          <line id=\"ground\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#738a7b\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n          <line id=\"pole\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#146b64\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n          <line id=\"shadowLine\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#416b81\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          <line id=\"shadowMeasure\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#416b81\" stroke-width=\"1.7\" marker-start=\"url(#arrow)\" marker-end=\"url(#arrow)\"/>\n          <path id=\"angleArc\" d=\"\" fill=\"none\" stroke=\"#146b64\" stroke-width=\"2.5\"/>\n          <text id=\"alphaLabel\" fill=\"#146b64\" font-size=\"16\" font-weight=\"700\">α</text>\n        </svg>\n      </div>\n      <div class=\"key\" aria-label=\"图例\">\n        <span><i class=\"swatch pole\"></i>竖直杆：1 米</span>\n        <span><i class=\"swatch\"></i>光线</span>\n        <span><i class=\"swatch shadow\"></i>影长 L</span>\n      </div>\n      <p class=\"diagram-note\">图中长度按同一比例绘制；小角度时影子会很长，图也会相应变宽。</p>\n    </article>\n\n    <article class=\"card controls\">\n      <section aria-labelledby=\"control-title\">\n        <h2 id=\"control-title\">改变光线仰角</h2>\n        <label for=\"angle\">光线与地面的夹角 α</label>\n        <div class=\"angle-readout\"><output id=\"angleOut\" for=\"angle\">45°</output><span>仰角</span></div>\n        <input id=\"angle\" type=\"range\" min=\"5\" max=\"85\" step=\"1\" value=\"45\" aria-describedby=\"rangeHelp\">\n        <div class=\"range-labels\" id=\"rangeHelp\"><span>5° 更贴近地面</span><span>85° 更接近竖直</span></div>\n      </section>\n      <section class=\"result\" aria-live=\"polite\" aria-atomic=\"true\">\n        <p class=\"result-label\">这时影长约为</p>\n        <p class=\"result-value\"><span id=\"lengthOut\">1.00</span> <small>米</small></p>\n        <p class=\"explain\" id=\"explain\">光线与地面成 45°。角度越大，影子越短。</p>\n      </section>\n      <section class=\"math\">\n        <h2>为什么会这样？</h2>\n        <div class=\"equation\">tan(α) = 杆高 ÷ 影长<small>所以：影长 L = 杆高 h ÷ tan(α)</small></div>\n        <p class=\"explain\">正切 tan(α) 描述这个直角三角形里“竖直高度”和“水平长度”的比例。杆高固定，角度变大时，这个比例变大，影长就变短。</p>\n      </section>\n    </article>\n  </section>\n\n  <section class=\"bottom\">\n    <article class=\"card\">\n      <h2>读图的关键</h2>\n      <p>角 α 是从<strong>水平地面</strong>量到光线的角，不是从竖直杆量。杆高 h 是对边，影长 L 是邻边；它们和 α 组成直角三角形。</p>\n    </article>\n    <article class=\"card\">\n      <h2>这个小模型假设</h2>\n      <p>杆笔直地立在水平地面上；阳光看作彼此平行的光线。这里只研究角度改变时的几何影长，不模拟太阳的完整运动、光线散开或模糊的影子边缘。</p>\n      <p class=\"limits\">角度只设在 5°–85°：完全贴着地面的 0° 会让公式没有有限影长；90° 的理想影长为 0。两端都不作为滑块值。</p>\n    </article>\n  </section>\n\n  <footer class=\"sources\">\n    <p>关系依据：OpenStax《Algebra and Trigonometry 2e》，第 7.2 节“Right Triangle Trigonometry”。</p>\n    <p>教材地址（供核对）：https://openstax.org/books/algebra-and-trigonometry-2e/pages/7-2-right-triangle-trigonometry</p>\n    <p>页面数值和图形是基于上述直角三角形关系的教学模型。</p>\n  </footer>\n</main>\n<script>\n(() => {\n  const slider = document.getElementById('angle');\n  const angleOut = document.getElementById('angleOut');\n  const lengthOut = document.getElementById('lengthOut');\n  const explain = document.getElementById('explain');\n  const diagram = document.getElementById('diagram');\n  const ray = document.getElementById('lightRay');\n  const triangle = document.getElementById('triangle');\n  const ground = document.getElementById('ground');\n  const pole = document.getElementById('pole');\n  const shadow = document.getElementById('shadowLine');\n  const measure = document.getElementById('shadowMeasure');\n  const arc = document.getElementById('angleArc');\n  const alpha = document.getElementById('alphaLabel');\n  const h = 1;\n  const scale = 100;\n  function update() {\n    const degrees = Number(slider.value);\n    const radians = degrees * Math.PI / 180;\n    const L = h / Math.tan(radians);\n    const x0 = 72, yGround = 199, yTop = yGround - scale;\n    const xTip = x0 + L * scale;\n    const width = xTip + 54;\n    diagram.setAttribute('viewBox', `0 0 ${width} 260`);\n    ground.setAttribute('x1', '25'); ground.setAttribute('x2', String(width - 18)); ground.setAttribute('y1', String(yGround)); ground.setAttribute('y2', String(yGround));\n    pole.setAttribute('x1', String(x0)); pole.setAttribute('x2', String(x0)); pole.setAttribute('y1', String(yTop)); pole.setAttribute('y2', String(yGround));\n    shadow.setAttribute('x1', String(x0)); shadow.setAttribute('x2', String(xTip)); shadow.setAttribute('y1', String(yGround)); shadow.setAttribute('y2', String(yGround));\n    measure.setAttribute('x1', String(x0 + 5)); measure.setAttribute('x2', String(xTip - 5)); measure.setAttribute('y1', String(yGround + 24)); measure.setAttribute('y2', String(yGround + 24));\n    ray.setAttribute('d', `M ${x0} ${yTop} L ${xTip} ${yGround}`);\n    triangle.setAttribute('d', `M ${x0} ${yTop} L ${xTip} ${yGround} L ${x0} ${yGround} Z`);\n    const arcR = 31;\n    const arcStartX = xTip - arcR, arcStartY = yGround;\n    const arcEndX = xTip - arcR * Math.cos(radians), arcEndY = yGround - arcR * Math.sin(radians);\n    arc.setAttribute('d', `M ${arcStartX} ${arcStartY} A ${arcR} ${arcR} 0 0 0 ${arcEndX} ${arcEndY}`);\n    alpha.setAttribute('x', String(xTip - 46)); alpha.setAttribute('y', String(yGround - 11));\n    angleOut.value = `${degrees}°`; angleOut.textContent = `${degrees}°`;\n    lengthOut.textContent = L.toFixed(2);\n    explain.textContent = `光线与地面成 ${degrees}°。杆高保持 1 米；角度越大，影子越短。`;\n    document.getElementById('svgDesc').textContent = `竖直杆高一米，光线与地面的夹角为${degrees}度，影长约${L.toFixed(2)}米；图形长度按同一比例绘制。`;\n  }\n  slider.addEventListener('input', update);\n  update();\n})();\n</script>\n</body>\n</html>\n"
            }
          ],
          "status": "completed"
        },
